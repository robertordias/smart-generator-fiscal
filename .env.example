# Copie para .env e defina suas senhas. Não adicionar .env ao Git.
DB_NAME=fiscal
DB_USER=fiscal
DB_PASSWORD=troque-esta-senha-postgresql
APP_ADMIN_PASSWORD=MinhaSenhaForte123
DB_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=3000
APP_TENANT_ID=00000000-0000-0000-0000-000000000001
APP_COOKIE_SECURE=false
# Login opcional do cliente. Preencher os dois campos para habilitar.
APP_CLIENT_PASSWORD=
APP_CLIENT_ISSUER_ID=

# Para usar os A1 já cadastrados, mantenha EXATAMENTE a chave mestra anterior.
NFSE_MASTER_KEY=
# Coloque o truststore ICP-Brasil em ./secrets e indique o caminho no contêiner.
NFSE_ICP_TRUSTSTORE=
# Exemplo: /run/fiscal-secrets/icp-truststore.p12
NFSE_ICP_TRUSTSTORE_PASSWORD=
NFSE_ENVIRONMENT=HOMOLOGACAO
NFSE_PRODUCTION_ENABLED=false
NFSE_CHECK_REVOCATION=true
NFSE_SIGNATURE_ALGORITHM=SHA256
